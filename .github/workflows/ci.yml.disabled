# CI — DORMANT. The `.disabled` suffix keeps GitHub from parsing this file at all; the gate that
# actually runs is `just check` locally, plus the prek hooks (`.pre-commit-config.yaml`).
#
# Kept, and kept CORRECT, because a dormant workflow rots silently: the previous version described a
# tree that no longer exists. It said "no staticlib to pre-build … the in-tree `CSlopDeskSIMD` C
# target", and both halves are gone — the C target was deleted when the SIMD kernels moved to
# `rust/slopdesk-gfsimd`, and `Package.swift` now declares a `binaryTarget` at
# `ThirdParty/slopdesk-ffi/SlopDeskFFI.xcframework`, which is gitignored. A fresh checkout therefore
# cannot RESOLVE the package, let alone build it, until `just ffi` has run — the same
# defect `release.yml` carried until it grew a build step (docs/49, docs/55).
#
# It also ran no Rust at all: seventeen workspaces of clippy and cargo test, and the Miri audit that
# pays for the `unsafe` in `slopdesk-gfsimd`, were invisible to it.
#
# Every job below shells out to a `just` target rather than restating its commands. That is the
# point: the justfile derives its lists (`RUST_WORKSPACES`, `just --dry-run` plans), and a workflow that
# copies them is a second list to forget.

name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  # Text-only gates: no Swift toolchain, no Rust, no Xcode. Cheap and first to fail.
  shell:
    name: Shell (shellcheck · shfmt)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install tools
        run: |
          set -euo pipefail
          sudo apt-get update && sudo apt-get install -y shellcheck
          curl -sSL -o /tmp/shfmt https://github.com/mvdan/sh/releases/latest/download/shfmt_v3.13.1_linux_amd64
          chmod +x /tmp/shfmt && sudo mv /tmp/shfmt /usr/local/bin/shfmt
      - run: just lint-shell

  # Rust: every workspace, on macOS because several crates speak to macOS APIs and the FFI slices
  # target Apple triples. `just lint-rust` is clippy + rustfmt across all seventeen roots; `just
  # test-rust` is their suites; `just miri` is the memory half that pays for the `unsafe` crate.
  rust:
    name: Rust (clippy · rustfmt · tests · Miri)
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - name: Toolchains
        run: |
          set -euo pipefail
          rustup toolchain install nightly --component rustfmt miri
          rustup target add aarch64-apple-darwin aarch64-apple-ios aarch64-apple-ios-sim
      - run: just lint-rust
      # The cross-language ratchets, including the design-token and menu-shortcut ones that used to
      # be shell scripts in the `swift-lint` job. They read text and need no Swift toolchain.
      - run: just lint-invariants
      - run: just test-rust
      - run: just miri

  # Swift lint needs no compile, so it does not wait on the FFI artifact or on Xcode selection.
  swift-lint:
    name: Swift (SwiftFormat · SwiftLint --strict)
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - run: brew install swiftlint swiftformat
      # The design-token and menu-shortcut ratchets used to run here as two shell scripts; they are
      # `slopdesk-invariants` rules now and run in the `rust` job, which needs no Swift toolchain.
      - run: just lint-swift

  # The compiling half. `just ffi` FIRST and not optionally: SwiftPM cannot resolve a graph whose
  # `binaryTarget` path is absent, so this is the step that makes `swift build` possible at all.
  # `just lint-reach` lives here rather than in `swift-lint` because its FFI staleness half judges
  # the artifact the step above assembles.
  swift-build-test:
    name: Swift build + test + golden (needs Xcode 26.5+)
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - name: Select newest Xcode
        run: sudo xcode-select -s /Applications/Xcode_26.5.app || echo "Xcode 26.5 not on this image — the package targets .v26"
      - name: Rust targets for the linked FFI slices
        run: rustup target add aarch64-apple-darwin aarch64-apple-ios aarch64-apple-ios-sim
      - run: just ffi
      - run: just lint-reach
      - run: just build
      # `just test`, not `swift test`. Eighteen suites boot a real sidecar and `XCTSkip` by name
      # when its binary is absent — and `swift build` never sees cargo, so a bare `swift test` on a
      # fresh runner would skip the entire supervised, screen and file-drop surface and report
      # green. `just test` builds the sidecars first.
      - run: just test
      - run: just golden
