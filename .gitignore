# Swift Package Manager / Xcode build artifacts
.build/
# Transient out-of-tree build dirs (e.g. .build-ios-rel/, .build-ios-studio/) —
# alternate SwiftPM/Xcode output roots; derived artifacts, never committed.
.build-*/
hid-bridge/build/
DerivedData/
*.o
*.swiftmodule

# Local work / tooling dirs (transient — never committed).
# /.work/ = repo-root scratch: build logs, the iOS DerivedData (-derivedDataPath .work/ios-dd),
#           xcframework backups, etc. (ThirdParty/ghostty/.work/ is ignored separately below.)
# .claude/ = Claude Code session state (scheduled_tasks.lock, etc.).
/.work/
.claude/

# VS Code editor state. launch.json is REGENERATED by the Swift extension — one debug/release
# pair per executable target in Package.swift — so committing it means re-committing it after
# every target added or renamed, for nothing the manifest doesn't already say.
.vscode/

# Xcode user state
*.xcuserstate
xcuserdata/
.swiftpm/xcode/

# macOS
.DS_Store

# WF-8 Xcode app projects — generated from the committed project.yml (source of truth).
# Regenerate with: xcodegen generate --spec Apps/<App>/project.yml
# The .xcodeproj is derived; the project.yml + sources + Info.plist + entitlements are
# the committed deliverable.
Apps/**/*.xcodeproj

# NOTE: Package.resolved is intentionally NOT ignored — pin the dependency graph.

# WF-5 libghostty build infra — derived / large artifacts (the SCRIPT is committed;
# the toolchain, cloned source, and built binary are reproducible from pinned SHAs).
# NOTE: .gitignore does NOT support inline comments — patterns must stand alone.
# .toolchain/ = downloaded pinned Zig (~80 MB extracted).
# .work/      = shallow clone of pinned ghostty fork + Zig caches.
# *.xcframework/ = assembled XCFramework (built artifact; fork emits "GhosttyKit").
# Vendored host-side runtime deps — the PIN (tools.lock), the recipe (provision.sh) and the
# one small committed artifact (vendor/scrcpy-server, 716 KB) are the deliverable; the provisioned
# tree is not. .prefix/ runs to ~730 MB extracted (code-server carries its own Node).
ThirdParty/tools/.prefix/

ThirdParty/ghostty/.toolchain/
ThirdParty/ghostty/.work/
ThirdParty/ghostty/build/
ThirdParty/ghostty/libghostty.xcframework/
ThirdParty/ghostty/GhosttyKit.xcframework/
*.xcframework/
# Defensive: any *.xcframework* sibling (e.g. a "*.xcframework.incomplete-bak" repair
# backup left by an artifact-rebuild step). The "*.xcframework/" pattern above only
# matches the exact ".xcframework/" directory boundary, not ".xcframework.<suffix>".
ThirdParty/ghostty/*.xcframework*
.work/

# Release artifacts built by scripts/package-release.sh (dmg / tarball / SHA256SUMS).
# They live on the GitHub Release, never in git.
dist/

# ui-shell reference demo videos (kept on disk for reference, too large for git)
docs/ui-shell/screenshots/*.mp4
docs/ui-shell/screenshots/*.mov
docs/ui-shell/screenshots/*.webm

# python bytecode from repo scripts
__pycache__/

# Rust build products. A pattern per workspace would miss the next one silently — hundreds of
# megabytes of artifacts one `git add -A` away — so this matches any `target` under `rust/`, which
# is a name cargo owns there and nothing else uses.
#
# BOTH spellings, and the one without the slash is the load-bearing half: since the artifacts moved
# out of the checkout (`just relink-targets`, docs/46) each `target` is a SYMLINK to the sibling
# `slopdesk-targets` tree, and a trailing-slash pattern does not match a symlink — git would offer
# 73 of them as untracked.
rust/**/target/
rust/**/target
rust/target/
rust/target

# Built by scripts/build-ffi.sh from rust/slopdesk-ffi — 17 MB of slices that change on every
# Rust edit. Same reasoning as libghostty above: a build output, not a source.
ThirdParty/slopdesk-ffi/
