{
    "$schema": "vscode://schemas/color-theme",
    "name": "Foundry Ember",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "focusBorder": "#60CDCD66",
        "foreground": "#ADA8A3",
        "descriptionForeground": "#7C7874",
        "disabledForeground": "#7C7874",
        "errorForeground": "#FB939C",
        "textLink.foreground": "#60CDCD",
        "textLink.activeForeground": "#60CDCD",
        "selection.background": "#3E3833",
        "widget.shadow": "#00000066",
        "sash.hoverBorder": "#60CDCD",
        "editor.background": "#27221E",
        "editor.foreground": "#E6DED6",
        "editorLineNumber.foreground": "#7C7874",
        "editorLineNumber.activeForeground": "#ADA8A3",
        "editorCursor.foreground": "#60CDCD",
        "editor.selectionBackground": "#3E3833",
        "editor.inactiveSelectionBackground": "#322C29",
        "editor.lineHighlightBackground": "#E6DED60A",
        "editor.lineHighlightBorder": "#00000000",
        "editor.findMatchBackground": "#E5BD664D",
        "editor.findMatchHighlightBackground": "#E5BD6626",
        "editorWhitespace.foreground": "#7C787466",
        "editorIndentGuide.background1": "#E6DED61A",
        "editorIndentGuide.activeBackground1": "#7C7874CC",
        "editorBracketMatch.background": "#00000000",
        "editorBracketMatch.border": "#60CDCD",
        "editorError.foreground": "#FB939C",
        "editorWarning.foreground": "#E5BD66",
        "editorInfo.foreground": "#78BEEF",
        "editorHint.foreground": "#7C7874",
        "editorLink.activeForeground": "#60CDCD",
        "editorWidget.background": "#322C29",
        "editorWidget.border": "#E6DED61A",
        "editorHoverWidget.background": "#322C29",
        "editorHoverWidget.border": "#E6DED61A",
        "editorSuggestWidget.background": "#322C29",
        "editorSuggestWidget.border": "#E6DED61A",
        "editorSuggestWidget.selectedBackground": "#3E3833",
        "editorSuggestWidget.highlightForeground": "#60CDCD",
        "editorGutter.modifiedBackground": "#E5BD66",
        "editorGutter.addedBackground": "#8DCD8E",
        "editorGutter.deletedBackground": "#FB939C",
        "diffEditor.insertedTextBackground": "#8DCD8E1F",
        "diffEditor.removedTextBackground": "#FB939C1F",
        "sideBar.background": "#201B17",
        "sideBar.foreground": "#ADA8A3",
        "sideBar.border": "#E6DED61A",
        "sideBarTitle.foreground": "#E6DED6",
        "sideBarSectionHeader.background": "#201B17",
        "sideBarSectionHeader.foreground": "#ADA8A3",
        "sideBarSectionHeader.border": "#E6DED61A",
        "activityBar.background": "#201B17",
        "activityBar.foreground": "#E6DED6",
        "activityBar.inactiveForeground": "#7C7874",
        "activityBar.border": "#E6DED61A",
        "activityBarBadge.background": "#009898",
        "activityBarBadge.foreground": "#E6DED6",
        "statusBar.background": "#201B17",
        "statusBar.foreground": "#ADA8A3",
        "statusBar.border": "#E6DED61A",
        "statusBar.noFolderBackground": "#201B17",
        "statusBar.noFolderBorder": "#E6DED61A",
        "statusBar.debuggingBackground": "#201B17",
        "statusBarItem.remoteBackground": "#009898",
        "statusBarItem.remoteForeground": "#E6DED6",
        "titleBar.activeBackground": "#27221E",
        "titleBar.activeForeground": "#ADA8A3",
        "titleBar.inactiveBackground": "#27221E",
        "titleBar.inactiveForeground": "#7C7874",
        "titleBar.border": "#E6DED61A",
        "panel.background": "#27221E",
        "panel.border": "#E6DED61A",
        "panelTitle.activeForeground": "#E6DED6",
        "panelTitle.activeBorder": "#60CDCD",
        "panelTitle.inactiveForeground": "#7C7874",
        "editorGroup.border": "#E6DED61A",
        "editorGroupHeader.tabsBackground": "#201B17",
        "editorGroupHeader.tabsBorder": "#E6DED61A",
        "tab.activeBackground": "#27221E",
        "tab.activeForeground": "#E6DED6",
        "tab.inactiveBackground": "#201B17",
        "tab.inactiveForeground": "#7C7874",
        "tab.border": "#E6DED61A",
        "tab.activeBorderTop": "#00000000",
        "list.activeSelectionBackground": "#322C29",
        "list.activeSelectionForeground": "#E6DED6",
        "list.inactiveSelectionBackground": "#322C29",
        "list.hoverBackground": "#E6DED60D",
        "list.focusBackground": "#322C29",
        "list.highlightForeground": "#60CDCD",
        "tree.indentGuidesStroke": "#E6DED61A",
        "input.background": "#201B17",
        "input.foreground": "#E6DED6",
        "input.border": "#E6DED61A",
        "input.placeholderForeground": "#7C7874",
        "inputValidation.errorBackground": "#322C29",
        "inputValidation.errorBorder": "#FB939C",
        "dropdown.background": "#322C29",
        "dropdown.foreground": "#E6DED6",
        "dropdown.border": "#E6DED61A",
        "checkbox.background": "#201B17",
        "checkbox.border": "#E6DED61A",
        "button.background": "#60CDCD",
        "button.foreground": "#171310",
        "button.secondaryBackground": "#322C29",
        "button.secondaryForeground": "#E6DED6",
        "badge.background": "#009898",
        "badge.foreground": "#E6DED6",
        "progressBar.background": "#60CDCD",
        "scrollbarSlider.background": "#E6DED61A",
        "scrollbarSlider.hoverBackground": "#E6DED62E",
        "scrollbarSlider.activeBackground": "#E6DED642",
        "pickerGroup.foreground": "#60CDCD",
        "quickInput.background": "#322C29",
        "quickInputList.focusBackground": "#3E3833",
        "menu.background": "#322C29",
        "menu.foreground": "#E6DED6",
        "menu.selectionBackground": "#3E3833",
        "notifications.background": "#322C29",
        "notifications.border": "#E6DED61A",
        "notificationCenterHeader.background": "#322C29",
        "settings.headerForeground": "#E6DED6",
        "settings.modifiedItemIndicator": "#E5BD66",
        "peekView.border": "#60CDCD",
        "peekViewEditor.background": "#201B17",
        "peekViewResult.background": "#201B17",
        "peekViewTitle.background": "#201B17",
        "gitDecoration.modifiedResourceForeground": "#E5BD66",
        "gitDecoration.untrackedResourceForeground": "#8DCD8E",
        "gitDecoration.addedResourceForeground": "#8DCD8E",
        "gitDecoration.deletedResourceForeground": "#FB939C",
        "gitDecoration.ignoredResourceForeground": "#7C7874",
        "gitDecoration.conflictingResourceForeground": "#E399D3",
        "terminal.background": "#27221E",
        "terminal.foreground": "#E6DED6",
        "terminal.selectionBackground": "#3E3833",
        "terminalCursor.foreground": "#60CDCD",
        "terminal.ansiBlack": "#3A3431",
        "terminal.ansiRed": "#FB939C",
        "terminal.ansiGreen": "#8DCD8E",
        "terminal.ansiYellow": "#E5BD66",
        "terminal.ansiBlue": "#56B9DD",
        "terminal.ansiMagenta": "#BCAAF4",
        "terminal.ansiCyan": "#66CCD1",
        "terminal.ansiWhite": "#ADA8A3",
        "terminal.ansiBrightBlack": "#7C7874",
        "terminal.ansiBrightRed": "#FFBBBF",
        "terminal.ansiBrightGreen": "#ABE6AC",
        "terminal.ansiBrightYellow": "#FCD78A",
        "terminal.ansiBrightBlue": "#7CD1F3",
        "terminal.ansiBrightMagenta": "#D4C8FF",
        "terminal.ansiBrightCyan": "#8CE4E9",
        "terminal.ansiBrightWhite": "#E6DED6"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#7C7874",
                "fontStyle": "italic"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#E5BD66"
            }
        },
        {
            "name": "Regular expression",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#E399D3"
            }
        },
        {
            "name": "Number / constant",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#BCAAF4"
            }
        },
        {
            "name": "Keyword / storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.operator.new",
                "keyword.operator.expression"
            ],
            "settings": {
                "foreground": "#FB939C"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#FB939C"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic"
            ],
            "settings": {
                "foreground": "#8DCD8E"
            }
        },
        {
            "name": "Type / class",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#66CCD1"
            }
        },
        {
            "name": "Parameter",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#F2A56F",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "support.variable"
            ],
            "settings": {
                "foreground": "#E6DED6"
            }
        },
        {
            "name": "Object property",
            "scope": [
                "variable.other.property",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#E6DED6"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#FB939C"
            }
        },
        {
            "name": "Tag attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#66CCD1",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#ADA8A3"
            }
        },
        {
            "name": "Decorator / annotation",
            "scope": [
                "meta.decorator",
                "punctuation.decorator",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#66CCD1"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid"
            ],
            "settings": {
                "foreground": "#FB939C"
            }
        },
        {
            "name": "Markup heading",
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#E5BD66",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#E6DED6",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#E6DED6",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup link",
            "scope": [
                "markup.underline.link"
            ],
            "settings": {
                "foreground": "#60CDCD"
            }
        },
        {
            "name": "Markup quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#7C7874",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup inline code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code.block"
            ],
            "settings": {
                "foreground": "#8DCD8E"
            }
        },
        {
            "name": "Markup list bullet",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "markup.list.bullet"
            ],
            "settings": {
                "foreground": "#FB939C"
            }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#8DCD8E"
            }
        },
        {
            "name": "Diff deleted",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#FB939C"
            }
        },
        {
            "name": "Diff changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#E5BD66"
            }
        }
    ]
}
